<?xml version="1.0" encoding="utf-8"?>
<!-- Der Tontaube-Server läuft im Heimnetz unter frei wählbaren IP-Adressen und spricht HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
